PORT=4000
# Tetap 127.0.0.1: akses dari luar lewat Caddy (HTTPS) di api.sonokembangmalang.tech
HOST=127.0.0.1

# Database MySQL di Premium Web Hosting (Remote MySQL). Host lihat di hPanel › Databases › Remote MySQL
DB_HOST=srv612.hstgr.io
DB_PORT=3306
DB_USER=u143987767_CRM
DB_PASS=ganti_password
DB_NAME=u143987767_CRM

# Harus sama dengan VPS_API_KEY di website/.env
VPS_API_KEY=ganti_dengan_string_acak_panjang
# Alamat website CI3 (untuk perintah balik ke website, mis. buat lead otomatis)
WEBSITE_URL=https://crm.sonokembangmalang.tech

# WhatsApp: simulator (tidak benar-benar kirim) atau meta (WhatsApp Cloud API)
WA_MODE=simulator
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=ganti_token_verifikasi_webhook
WA_APP_SECRET=

TZ=Asia/Jakarta
