# Salin jadi .env lalu isi. JANGAN commit file .env ke GitHub.

# Domain CRM (arahkan DNS A-record ke IP VPS), mis. crm.sonokembangcateringmalang.com
DOMAIN=crm.contoh.com

# Kata sandi database — buat acak: openssl rand -base64 24
DB_PASSWORD=

# Kunci enkripsi API key AI — WAJIB, buat sekali dan simpan baik-baik: openssl rand -base64 32
# Kalau hilang/diganti, API key AI yang tersimpan harus dipasang ulang.
APP_ENCRYPTION_KEY=

# Akun Admin pertama (hanya dipakai saat database masih kosong)
ADMIN_NAME=Raka
ADMIN_EMAIL=admin@sonokembangcateringmalang.com
ADMIN_PASSWORD=

# Lama sesi login (hari)
SESSION_DAYS=14

# ---------- Email (ringkasan harian & eskalasi SLA) ----------
# Bisa pakai email hosting Hostinger: buat akun mis. crm@sonokembangcateringmalang.com di hPanel → Email.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CRM Sonokembang <crm@sonokembangcateringmalang.com>

# ---------- WhatsApp ----------
# "simulator" sampai migrasi dari CRM lama; ganti "meta" saat nomor WABA dipindah.
WA_MODE=simulator
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
# Bebas, buat acak (openssl rand -hex 16); isi yang sama di Meta App Dashboard
WA_VERIFY_TOKEN=
# App Dashboard → Settings → Basic → App secret
WA_APP_SECRET=
WA_GRAPH_VERSION=v23.0
